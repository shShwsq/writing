# 复制为 .env 并填写

# OpenAI 兼容接口（DeepSeek: https://platform.deepseek.com）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
# deepseek-chat / deepseek-reasoner 均可
MODEL_NAME=deepseek-chat

# 守门人保管的密钥：游戏的目标。
# 填写日记加密密钥（与根目录 .env 的 GUARD_SECRET 相同），获胜者即可解密 diary.docx.enc
GUARD_SECRET=

# 防滥用（可选，括号内为默认值）
# 每 IP 每分钟对话/领取次数（10 / 20）
CHAT_RATE_LIMIT=10
CLAIM_RATE_LIMIT=20
# 工作量证明难度：sha256 前导十六进制 0 的个数（4），越大脚本刷接口越贵
POW_DIFFICULTY=4